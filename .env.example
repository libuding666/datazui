# ── 数据库 ────────────────────────────────────────────────────────────────
# 本地开发默认值就是下面这组，可以不建 .env 直接跑。
# 部署到 Vercel / 云数据库时，请在平台的环境变量里配置同样的键。

DZ_DB_HOST=127.0.0.1
DZ_DB_PORT=3306
DZ_DB_USER=root
DZ_DB_PASSWORD=123456
DZ_DB_NAME=datazui

# 也可以只用一条连接串代替上面五项（云厂商常给这种格式）
# DZ_DB_URL=mysql://user:password@host:4000/datazui

# 云 MySQL / TiDB Cloud 都强制 TLS，填 true 开启
# 若厂商要求校验 CA 证书，再设 STRICT=1（默认放宽，因为拿不到厂商 CA）
# DZ_DB_SSL=true
# DZ_DB_SSL_STRICT=1

# ── 云数据库常见差异（照抄控制台的连接信息，不要自己拼）────────────────────
# TiDB Cloud Starter（MySQL 协议，本项目代码可直接连）：
#   端口 4000（不是 3306）；TLS 必须开
#   用户名必须带实例前缀，形如  3pTAoNNegb47Uc8.root
#   区域建议选 Singapore / Tokyo，国内访问更稳
# Supabase（是 PostgreSQL，本项目当前用 MySQL 协议，不能直接连）：
#   若以后迁移过去，走事务模式连接池，端口 6543

# Serverless 下每个函数实例各自的连接池大小，默认 2，不要调大
# DZ_DB_POOL=2

# ── 服务 ──────────────────────────────────────────────────────────────────
# 本地默认只监听 127.0.0.1；需要局域网/容器访问时改成 0.0.0.0
# DZ_HOST=0.0.0.0
# DZ_PORT=4173

# 是否尝试自动建库。默认开启，失败会自动跳过（云账号常常没有 CREATE DATABASE 权限）
# DZ_DB_AUTOCREATE=0
